# ==========================================================================
# FORTRESS - Environment Variables (example / template)
# ==========================================================================
# Copy this file to .env and replace placeholder values with real secrets.
#   cp .env.example .env
# NEVER commit .env to version control.
# ==========================================================================

# --- PostgreSQL (superuser - used by the postgres container itself) ---
POSTGRES_DB=fortress
POSTGRES_USER=fortress_admin
POSTGRES_PASSWORD=replace-with-strong-password

# --- PostgreSQL (application role - used by flask-api) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=change-me

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_HOURS=1

# --- RBAC ---
RBAC_POLICY_PATH=/app/policies/rbac.json
